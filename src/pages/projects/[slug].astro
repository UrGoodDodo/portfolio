---
import BaseLayout from '../../layouts/BaseLayout.astro';

import ProjectMeta from '../../components/project/ProjectMeta.astro';
import HeroImage from '../../components/project/HeroImage.astro';
import HeroVideo from '../../components/project/HeroVideo.astro';
import Gallery from '../../components/project/Gallery.astro';
import BeforeAfter from '../../components/project/BeforeAfter.astro';
import GameplayVideo from '../../components/project/GameplayVideo.astro';
import ProjectLinks from '../../components/project/ProjectLinks.astro';
import MarkdownSection from '../../components/project/MarkdownSection.astro';

import {
  getCollection,
  type CollectionEntry,
} from 'astro:content';

import {
  getProjectContent,
  renderMarkdownSection,
  formatSectionTitle,
} from '../../utils/projectContent';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: {
      slug: project.id.split('/')[0],
    },
    props: {
      project,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const data = project.data;

const projectId = project.id.split('/')[0];

const contentEntry = await getProjectContent(projectId);

const contentBody = contentEntry?.body ?? '';
---

<BaseLayout title={data.title}>
  <article class="project-page">

    <header class="project-page__header">
      <a href="/projects">← Back to Projects</a>

      <h1>{data.title}</h1>

      <p>{data.description}</p>

      <ProjectMeta
        year={data.year}
        roles={data.roles}
        technologies={data.technologies}
      />
    </header>

    {
      await Promise.all(
        data.sections.map(async (section) => {
          switch (section) {
            case 'hero-image':
              return <HeroImage project={project} />;

            case 'hero-video':
              return <HeroVideo project={project} />;

            case 'before-after':
              return <BeforeAfter project={project} />;

            case 'gameplay-video':
              return <GameplayVideo project={project} />;

            case 'gallery':
              return <Gallery project={project} />;

            case 'project-links':
              return <ProjectLinks project={project} />;

            default: {
              const content = await renderMarkdownSection(
                contentBody,
                section
              );

              return (
                <MarkdownSection
                  title={formatSectionTitle(section)}
                  content={content}
                />
              );
            }
          }
        })
      )
    }

  </article>
</BaseLayout>