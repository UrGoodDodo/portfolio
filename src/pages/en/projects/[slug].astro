---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectPage from '../../../components/pages/ProjectPage.astro';

import {
  getProjectsByLanguage,
  getProjectSlug,
} from '../../../utils/projectContent';

import type {
  CollectionEntry,
} from 'astro:content';

const lang = 'en';

export async function getStaticPaths() {
  const projects =
    await getProjectsByLanguage('en');

  return projects.map((project) => ({
    params: {
      slug: getProjectSlug(project.id),
    },

    props: {
      project,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<BaseLayout
  title={project.data.title}
  lang={lang}
>
  <ProjectPage
    project={project}
    lang={lang}
  />
</BaseLayout>