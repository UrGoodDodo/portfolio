---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

import type { Language } from '../i18n/config';

interface Props {
  title?: string;
  lang: Language;
}

const {
  title = 'Portfolio',
  lang,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <Header lang={lang} />

    <main>
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>