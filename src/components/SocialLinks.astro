---
import {
  socialLinks,
  type SocialLink,
} from '../config/socialLinks';

interface Props {
  links?: SocialLink[];
}

const {
  links = socialLinks,
} = Astro.props;
---

<div class="social-links">
  {links.map((link) => (
    <a
      class="social-link"
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={link.label}
    >
      {link.icon === 'telegram' && (
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="M21.9 4.6c.3-1.3-.5-1.8-1.4-1.4L2.9 10c-1.2.5-1.2 1.2-.2 1.5l4.5 1.4 1.7 5.2c.2.6.1.9.8.9.5 0 .8-.2 1-.4l2.2-2.1 4.6 3.4c.8.5 1.4.2 1.6-.8l2.8-14.5ZM8.6 12.6l8.8-5.5c.4-.3.8-.1.5.2l-7.3 6.6-.3 3.4-1.7-4.7Z"
          />
        </svg>
      )}

      {link.icon === 'github' && (
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.6.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0C17 5.9 18 6.2 18 6.2c.6 1.5.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.8 5.5-5.5 5.8.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .7Z"
          />
        </svg>
      )}

      <span>
        {link.label}
      </span>
    </a>
  ))}
</div>