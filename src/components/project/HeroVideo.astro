---
import '../../styles/project/gameplay-video.css';

import type { CollectionEntry } from 'astro:content';
import type { Language } from '../../i18n/config';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Language;
}

const {
  project,
} = Astro.props;

const data = project.data;
---

{data.gameplayVideo && (
  <section class="project-section gameplay-video">
    <div class="gameplay-video__container">
      <video
        class="gameplay-video__media"
        controls
        playsinline
        preload="metadata"
      >
        <source src={data.gameplayVideo} />
      </video>
    </div>
  </section>
)}