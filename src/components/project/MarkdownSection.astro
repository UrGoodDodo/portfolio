---
import '../../styles/project/markdown-section.css';

interface Props {
  title: string;
  content?: string | null;
  variant?: 'default' | 'overview' | 'technical';
}

const {
  title,
  content,
  variant = 'default',
} = Astro.props;

const showTitle = variant === 'default';
---

{content && (
  <section
    class:list={[
      'project-section',
      'markdown-section',
      `markdown-section--${variant}`,
    ]}
  >
    {showTitle && (
      <h2 class="markdown-section__title">
        {title}
      </h2>
    )}

    <div
      class="project-section__content"
      set:html={content}
    />
  </section>
)}