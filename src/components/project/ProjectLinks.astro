---
import '../../styles/project/project-links.css';

import type { CollectionEntry } from 'astro:content';
import type { Language } from '../../i18n/config';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Language;
}

const {
  project,
} = Astro.props;

const data = project.data;

const links = data.links ?? [];
---

{links.length > 0 && (
  <section class="project-section project-links">
    <div class="project-links__list">
      {
        links.map((link) => (
          <a
            class="project-links__link"
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="project-links__label">
              {link.label}
            </span>

            <span
              class="project-links__icon"
              aria-hidden="true"
            >
              ↗
            </span>
          </a>
        ))
      }
    </div>
  </section>
)}