---
import type { Language } from '../i18n/config';

import {
  getUi,
  getLocalizedPath,
} from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const t = getUi(lang);

const homeUrl = `/${lang}/`;
const projectsUrl = `/${lang}/projects`;
const aboutUrl = `/${lang}/about`;

const englishUrl =
  getLocalizedPath(
    Astro.url.pathname,
    'en'
  );

const russianUrl =
  getLocalizedPath(
    Astro.url.pathname,
    'ru'
  );
---

<header class="site-header">
  <nav>

    <a href={homeUrl}>
      {t.site.name}
    </a>

    <div>
      <a href={homeUrl}>
        {t.nav.home}
      </a>

      <a href={projectsUrl}>
        {t.nav.projects}
      </a>

      <a href={aboutUrl}>
        {t.nav.about}
      </a>
    </div>

    <div class="language-switcher">
      <a
        href={englishUrl}
        aria-current={
          lang === 'en'
            ? 'page'
            : undefined
        }
      >
        EN
      </a>

      <span>/</span>

      <a
        href={russianUrl}
        aria-current={
          lang === 'ru'
            ? 'page'
            : undefined
        }
      >
        RU
      </a>
    </div>

  </nav>
</header>