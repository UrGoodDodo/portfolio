---
import type { Language } from '../i18n/config';

import {
  withBase,
} from '../utils/basePath';

import {
  getUi,
  getLocalizedPath,
} from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const t = getUi(lang);


/* ---------------- NAVIGATION ---------------- */

const homeUrl =
  withBase(`/${lang}/`);

const projectsUrl =
  withBase(`/${lang}/projects`);

const aboutUrl =
  withBase(`/${lang}/about`);


/* ---------------- LANGUAGE LINKS ---------------- */

const pathname =
  Astro.url.pathname;

const rootUrl =
  withBase('/');

const isRootPage =
  pathname === rootUrl ||
  pathname === rootUrl.replace(
    /\/$/,
    ''
  );

const englishUrl =
  isRootPage
    ? withBase('/')
    : getLocalizedPath(
        pathname,
        lang,
        'en'
      );

const russianUrl =
  isRootPage
    ? withBase('/ru/')
    : getLocalizedPath(
        pathname,
        lang,
        'ru'
      );
---

<header class="site-header">
  <nav>

    <a href={homeUrl}>
      {t.site.name}
    </a>

    <div>
      <a href={homeUrl}>
        {t.nav.home}
      </a>

      <a href={projectsUrl}>
        {t.nav.projects}
      </a>

      <a href={aboutUrl}>
        {t.nav.about}
      </a>
    </div>

    <div class="language-switcher">
      <a
        href={englishUrl}
        aria-current={
          lang === 'en'
            ? 'page'
            : undefined
        }
      >
        EN
      </a>

      <span>/</span>

      <a
        href={russianUrl}
        aria-current={
          lang === 'ru'
            ? 'page'
            : undefined
        }
      >
        RU
      </a>
    </div>

  </nav>
</header>